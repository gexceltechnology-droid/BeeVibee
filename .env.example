# ==============================================================================
# BeeVibe Production Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN AUTHENTICATION (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
# Production admin passcode. Must be at least 16 characters with high entropy.
# In production, the application will FAIL-CLOSED if unset or set to 'beevibe2026'.
# Generate with: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
ADMIN_PASSCODE=your_production_secret_passcode_minimum_16_characters

# Phone verification signing secret (optional; defaults to ADMIN_PASSCODE if omitted)
PHONE_VERIFICATION_SECRET=your_phone_verification_token_secret_string

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (FIRESTORE CLOUD DATABASE - REQUIRED IN MULTI-INSTANCE PROD)
# ------------------------------------------------------------------------------
# In multi-instance / serverless production (e.g., Vercel, Cloud Run, AWS),
# Firestore is the authoritative shared ACID transactional database.
FIREBASE_ADMIN_PROJECT_ID=beevibe-5448e
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxx@beevibe-5448e.iam.gserviceaccount.com
# Note: Escape newlines as \n when pasting private key in single-line env systems (e.g. Vercel)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT SDK (PUBLIC WEB)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCjyvmPH_JmRFpMICbLoTUAhgzr6QJRiEs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=beevibe-5448e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=beevibe-5448e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=beevibe-5448e.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=908479901768
NEXT_PUBLIC_FIREBASE_APP_ID=1:908479901768:web:1a9a83eb7203b5cb0b1154

# ------------------------------------------------------------------------------
# 4. INSTANT ADMIN ALERTS & TELEGRAM BOT (@digmabeevibe_bot)
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram Chat ID to receive instant alerts
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. WHATSAPP & SMS NOTIFICATIONS
# ------------------------------------------------------------------------------
ADMIN_WHATSAPP_NUMBER=919900106474
ADMIN_PHONE=9900106474

# Fast2SMS for Indian mobile OTP delivery (DLT registered)
FAST2SMS_API_KEY=

# Twilio (Optional secondary SMS/WhatsApp channel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Meta WhatsApp Cloud API (Optional official business API)
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=

# CallMeBot (Optional WhatsApp fallback)
CALLMEBOT_API_KEY=

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bee Vibe" <bookings@beevibe.org>
ADMIN_EMAIL=gexceltechnology@gmail.com

# ------------------------------------------------------------------------------
# 7. EXTERNAL INTEGRATIONS & CRM
# ------------------------------------------------------------------------------
LEAD_MANAGER_CRM_URL=https://rental-license-ment-consideration.trycloudflare.com/api/leads
